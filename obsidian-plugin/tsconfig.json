{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["../src/*"],
      "@calmy/*": ["../src/*"]
    },
    "target": "es2018",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "types/**/*.d.ts", "../src/core/content/**/*.ts", "../src/domain/**/model.ts"]
}
